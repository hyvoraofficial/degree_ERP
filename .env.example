# ==========================================
# HYVORA Degree College EduERP - Root Environment Reference Template
# ==========================================
# NOTE: In Docker Compose, the backend reads ./backend/.env and the frontend
# receives NEXT_PUBLIC_API_URL during build/runtime.
# Keep this file as an architecture reference template only.

# ------------------------------------------
# BACKEND RUNTIME VARIABLES (backend/.env)
# ------------------------------------------
NODE_ENV=production
PORT=3002

# Supabase Dedicated PostgreSQL Connection Strings (Degree College Project)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# JWT Secret (Dedicated 64-char key for Degree College token signing)
JWT_SECRET="[YOUR-SECURE-64-CHAR-JWT-SECRET]"

# Allowed CORS Origins
CORS_ORIGINS="http://localhost:3003,https://degree.hyvora.in,https://*.degree.hyvora.in,https://*.hyvora.in"
ENABLE_SWAGGER=true

# ------------------------------------------
# FRONTEND RUNTIME VARIABLES (frontend/.env.local)
# ------------------------------------------
NEXT_PUBLIC_API_URL="https://api.degree.hyvora.in/api/v1"
NEXT_PUBLIC_APP_DOMAIN="degree.hyvora.in"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
