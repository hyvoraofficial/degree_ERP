# =========================================================
# HYVORA EduERP - Production Environment Configuration Template
# =========================================================

# ---------------------------------------------------------
# BACKEND SERVER-ONLY CONFIGURATION
# ---------------------------------------------------------
NODE_ENV=production
PORT=3002

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Direct URL for Prisma migrations/schema operations (Direct Connection)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Supabase Object Storage & Project Credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # SERVER-ONLY! NEVER EXPOSE TO FRONTEND!

# JWT Authentication Secret Key
JWT_SECRET="production_super_secret_jwt_signing_key_change_in_prod_64_chars"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:3001,https://hyvorademo.in,https://*.hyvora.in,https://app.hyvora.in"

# Enable Swagger Documentation in Production (set to 'false' in true prod)
ENABLE_SWAGGER="true"

# ---------------------------------------------------------
# FRONTEND PUBLIC CONFIGURATION (BROWSER-ACCESSIBLE)
# ---------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3002/api/v1"
NEXT_PUBLIC_APP_DOMAIN="hyvora.in"
