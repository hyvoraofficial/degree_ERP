NODE_ENV=production
PORT=3002

# Supabase PostgreSQL Connection Strings (Project: eduERP_degree / Region: ap-south-1 Mumbai)
# Transaction Pooler URL (recommended for DATABASE_URL with Prisma in serverless / app):
DATABASE_URL="postgresql://postgres.ljfojsfbvqzcgzarburt:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (used for DIRECT_URL and Prisma migrations / db push on port 5432):
DIRECT_URL="postgresql://postgres.ljfojsfbvqzcgzarburt:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Project Credentials & Storage
SUPABASE_URL="https://ljfojsfbvqzcgzarburt.supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]" # SERVER ONLY

# Security & CORS
JWT_SECRET="production_super_secret_jwt_signing_key_change_in_prod_64_chars"
CORS_ORIGINS="http://localhost:3001,https://hyvorademo.in,https://*.hyvora.in"
ENABLE_SWAGGER=true
