datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Academy {
  id            String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String         @db.VarChar(255)
  subdomain     String         @unique @db.VarChar(100)
  domain        String?        @unique @db.VarChar(255)
  status        String         @default("active") @db.VarChar(50)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz

  users                    User[]
  roles                    Role[]
  students                 Student[]
  batches                  Batch[]
  settings                 AcademySetting?
  subscriptions            Subscription[]
  teachers                 Teacher[]
  teacherLeaves            TeacherLeave[]
  courses                  Course[]
  departments              Department[]
  subjects                 Subject[]
  classSchedules           ClassSchedule[]
  timetables               TimetableSchedule[]
  studentAttendance        Attendance[]
  teacherAttendance        TeacherAttendance[]
  feeStructures            FeeStructure[]
  feeAllocations           FeeAllocation[]
  paymentTransactions      PaymentTransaction[]
  payments                 Payment[]
  studyMaterials           StudyMaterial[]
  studyMaterialBatches     StudyMaterialBatch[]
  videoLectures            VideoLecture[]
  videoLectureBatches      VideoLectureBatch[]
  assignments              Assignment[]
  assignmentSubmissions    AssignmentSubmission[]
  exams                    Exam[]
  examPapers               ExamPaper[]
  examResults              ExamResult[]
  notifications            Notification[]
  notificationTemplates    NotificationTemplate[]
  websitePages             WebsitePage[]
  galleryAlbums            GalleryAlbum[]
  galleryImages            GalleryImage[]
  testimonials             Testimonial[]
  contactEnquiries         ContactEnquiry[]
  admissionEnquiries       AdmissionEnquiry[]
  dashboardCaches          DashboardCache[]
  mediaFiles               MediaFile[]
  branches                 Branch[]
  teacherSubjects          TeacherSubject[]
  placementDrives          PlacementDrive[]
  studentPlacements        StudentPlacement[]
  internshipRecords        InternshipRecord[]
  libraryBooks             LibraryBook[]
  bookIssues               BookIssueRecord[]
  semesterGrades           StudentSemesterGrade[]
  gradingSchemes           GradingScheme[]

  @@map("academies")
}

model User {
  id                 String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId          String     @map("academy_id") @db.Uuid
  email              String     @db.VarChar(255)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  initialPassword    String?    @map("initial_password") @db.VarChar(255)
  firstName          String     @map("first_name") @db.VarChar(150)
  lastName           String     @map("last_name") @db.VarChar(150)
  phone              String?    @db.VarChar(50)
  avatarId           String?    @map("avatar_id") @db.Uuid
  status             String     @default("active") @db.VarChar(50)
  refreshToken       String?    @map("refresh_token") @db.Text
  verificationToken  String?    @map("verification_token") @db.VarChar(255)
  isEmailVerified    Boolean    @default(false) @map("is_email_verified")
  isDefaultPassword  Boolean    @default(true) @map("is_default_password")
  resetPasswordToken String?    @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpires DateTime? @map("reset_password_expires") @db.Timestamptz
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz

  academy            Academy    @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student            Student?
  teacher            Teacher?
  userRoles          UserRole[]
  recordedPayments   Payment[]
  gradedSubmissions  AssignmentSubmission[] @relation("gradedSubmissions")
  gradedExamResults  ExamResult[]           @relation("gradedExamResults")
  notifications      Notification[]
  resolvedEnquiries  ContactEnquiry[]
  uploadedFiles      MediaFile[]
  loginActivities    LoginActivity[]

  @@unique([academyId, email], name: "uq_users_academy_email")
  @@map("users")
}

model Role {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId   String?          @map("academy_id") @db.Uuid
  name        String           @db.VarChar(100)
  code        String           @db.VarChar(100)
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz

  academy     Academy?         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([academyId, code], name: "uq_roles_academy_code")
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String           @unique @db.VarChar(100)
  code        String           @unique @db.VarChar(100)
  description String?
  resource    String           @db.VarChar(100)
  action      String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId    String     @map("academy_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "uq_role_permission")
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId String    @map("academy_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], name: "uq_user_role")
  @@map("user_roles")
}

model Branch {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId     String    @map("academy_id") @db.Uuid
  name          String    @db.VarChar(255)
  code          String    @db.VarChar(100)
  address       String    @db.Text
  city          String    @db.VarChar(100)
  state         String    @db.VarChar(100)
  pincode       String    @db.VarChar(20)
  contactNumber String    @map("contact_number") @db.VarChar(50)
  email         String    @db.VarChar(255)
  managerId     String?   @map("manager_id") @db.Uuid
  status        String    @default("active") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  academy       Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  departments   Department[]
  courses       Course[]
  batches       Batch[]
  students      Student[]
  teachers      Teacher[]
  teacherSubjects TeacherSubject[]
  timetables    TimetableSchedule[]
  attendances   Attendance[]

  @@unique([academyId, name], name: "uq_branches_name")
  @@unique([academyId, code], name: "uq_branches_code")
  @@map("branches")
}

model Department {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId     String    @map("academy_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  name          String    @db.VarChar(255)
  code          String    @db.VarChar(100)
  description   String?
  hodId         String?   @map("hod_id") @db.Uuid
  status        String    @default("active") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  academy       Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  hod           Teacher?  @relation("DepartmentHOD", fields: [hodId], references: [id], onDelete: SetNull)
  courses       Course[]
  subjects      Subject[]
  teachers      Teacher[] @relation("DepartmentFaculty")
  students      Student[]
  batches       Batch[]
  timetables    TimetableSchedule[]
  libraryBooks  LibraryBook[]

  @@unique([academyId, code], name: "uq_departments_academy_code")
  @@index([academyId])
  @@index([branchId])
  @@index([hodId])
  @@index([status])
  @@map("departments")
}

model Course {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId       String    @map("academy_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  departmentId    String?   @map("department_id") @db.Uuid
  name            String    @db.VarChar(255)
  code            String    @db.VarChar(100)
  degreeType      String?   @default("B.Tech") @map("degree_type") @db.VarChar(100)
  duration        String?   @default("4 Years") @db.VarChar(100)
  totalSemesters  Int       @default(8) @map("total_semesters")
  schemeYear      String?   @default("2026") @map("scheme_year") @db.VarChar(50)
  creditsRequired Int?      @default(160) @map("credits_required")
  description     String?
  syllabusId      String?   @map("syllabus_id") @db.Uuid
  status          String    @default("active") @db.VarChar(50)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  academy            Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  branch             Branch             @relation(fields: [branchId], references: [id])
  department         Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subjects           Subject[]
  students           Student[]
  admissionEnquiries AdmissionEnquiry[]
  batches            Batch[]
  teacherSubjects    TeacherSubject[]
  timetables         TimetableSchedule[]
  semesterGrades     StudentSemesterGrade[]

  @@unique([branchId, code], name: "uq_courses_branch_code")
  @@unique([branchId, name], name: "uq_courses_branch_name")
  @@index([academyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([degreeType])
  @@index([status])
  @@map("courses")
}

model Subject {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId       String          @map("academy_id") @db.Uuid
  courseId        String          @map("course_id") @db.Uuid
  departmentId    String?         @map("department_id") @db.Uuid
  semester        Int             @default(1)
  name            String          @db.VarChar(255)
  code            String          @db.VarChar(100)
  description     String?
  subjectType     String          @default("theory") @map("subject_type") @db.VarChar(50)
  credits         Int             @default(3)
  internalMarks   Decimal?        @default(40.00) @map("internal_marks") @db.Decimal(6, 2)
  externalMarks   Decimal?        @default(60.00) @map("external_marks") @db.Decimal(6, 2)
  totalMarks      Decimal?        @default(100.00) @map("total_marks") @db.Decimal(6, 2)
  passingMarks    Decimal?        @default(40.00) @map("passing_marks") @db.Decimal(6, 2)
  isElective      Boolean         @default(false) @map("is_elective")
  status          String          @default("active") @db.VarChar(50)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz

  academy         Academy         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department      Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schedules       ClassSchedule[]
  studyMaterials  StudyMaterial[]
  videoLectures   VideoLecture[]
  assignments     Assignment[]
  examPapers      ExamPaper[]
  attendance      Attendance[]
  teacherSubjects TeacherSubject[]
  timetables      TimetableSchedule[]

  @@unique([courseId, code], name: "uq_subjects_course_code")
  @@unique([courseId, name], name: "uq_subjects_course_name")
  @@index([academyId])
  @@index([courseId])
  @@index([departmentId])
  @@index([semester])
  @@index([subjectType])
  @@index([status])
  @@map("subjects")
}

model Batch {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId       String    @map("academy_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  departmentId    String?   @map("department_id") @db.Uuid
  name            String    @db.VarChar(255)
  code            String    @db.VarChar(100)
  academicYear    String?   @default("2026-2030") @map("academic_year") @db.VarChar(50)
  currentSemester Int       @default(1) @map("current_semester")
  sectionName     String?   @default("A") @map("section_name") @db.VarChar(50)
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  capacity        Int?      @map("capacity")
  status          String    @default("active") @db.VarChar(50)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  academy              Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  branch               Branch               @relation(fields: [branchId], references: [id])
  course               Course               @relation(fields: [courseId], references: [id])
  department           Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  students             Student[]
  schedules            ClassSchedule[]
  attendance           Attendance[]
  studyMaterialBatches StudyMaterialBatch[]
  videoLectureBatches  VideoLectureBatch[]
  assignments          Assignment[]
  examPapers           ExamPaper[]
  teacherSubjects      TeacherSubject[]
  timetables           TimetableSchedule[]

  @@unique([branchId, code], name: "uq_batches_branch_code")
  @@index([academyId])
  @@index([branchId])
  @@index([courseId])
  @@index([departmentId])
  @@index([currentSemester])
  @@index([academicYear])
  @@index([status])
  @@map("batches")
}

model Teacher {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId       String         @map("academy_id") @db.Uuid
  branchId        String?        @map("branch_id") @db.Uuid
  departmentId    String?        @map("department_id") @db.Uuid
  userId          String         @unique @map("user_id") @db.Uuid
  employeeNumber  String         @map("employee_number") @db.VarChar(100)
  designation     String?        @default("Assistant Professor") @db.VarChar(100)
  qualification   String?        @db.VarChar(255)
  experienceYears Int?           @default(3) @map("experience_years")
  specialization  String?        @db.VarChar(255)
  joiningDate     DateTime       @default(now()) @map("joining_date") @db.Date
  salaryStructure Json?          @map("salary_structure")
  status          String         @default("active") @db.VarChar(50)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz

  academy           Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  branch            Branch?             @relation(fields: [branchId], references: [id])
  department        Department?         @relation("DepartmentFaculty", fields: [departmentId], references: [id], onDelete: SetNull)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves            TeacherLeave[]
  schedules         ClassSchedule[]
  studentAttendance Attendance[]
  teacherAttendance TeacherAttendance[]
  studyMaterials    StudyMaterial[]
  videoLectures     VideoLecture[]
  assignments       Assignment[]
  teacherSubjects   TeacherSubject[]
  headedDepartment  Department[]        @relation("DepartmentHOD")
  timetables        TimetableSchedule[]
  mentoredInternships InternshipRecord[]

  @@unique([academyId, employeeNumber], name: "uq_teachers_academy_employee_number")
  @@index([academyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([userId])
  @@index([designation])
  @@index([status])
  @@map("teachers")
}

model Student {
  id                  String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId           String         @map("academy_id") @db.Uuid
  branchId            String         @map("branch_id") @db.Uuid
  userId              String         @unique @map("user_id") @db.Uuid
  courseId            String         @map("course_id") @db.Uuid
  batchId             String         @map("batch_id") @db.Uuid
  departmentId        String?        @map("department_id") @db.Uuid
  semester            Int            @default(1)
  section             String?        @default("A") @db.VarChar(50)
  admissionYear       String?        @default("2026") @map("admission_year") @db.VarChar(50)
  universityRegNumber String?        @map("university_reg_number") @db.VarChar(100)
  admissionNumber     String         @map("admission_number") @db.VarChar(100)
  admissionDate       DateTime       @default(now()) @map("admission_date") @db.Date
  dateOfBirth         DateTime       @map("date_of_birth") @db.Date
  gender              String?        @db.VarChar(50)
  bloodGroup          String?        @map("blood_group") @db.VarChar(20)
  parentName          String         @map("parent_name") @db.VarChar(255)
  parentPhone         String         @map("parent_phone") @db.VarChar(50)
  parentEmail         String?        @map("parent_email") @db.VarChar(255)
  fatherName          String?        @map("father_name") @db.VarChar(255)
  motherName          String?        @map("mother_name") @db.VarChar(255)
  rollNumber          String?        @map("roll_number") @db.VarChar(100)
  feePlan             String?        @map("fee_plan") @db.VarChar(100)
  studentStatus       String         @default("active") @map("student_status") @db.VarChar(50)
  studentPhotoId      String?        @map("student_photo_id") @db.Uuid
  aadhaarId           String?        @map("aadhaar_id") @db.Uuid
  previousMarksCardId String?        @map("previous_marks_card_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz

  academy               Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  branch                Branch             @relation(fields: [branchId], references: [id])
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                Course             @relation(fields: [courseId], references: [id])
  batch                 Batch              @relation(fields: [batchId], references: [id])
  department            Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  studentPhoto          MediaFile?         @relation("studentPhoto", fields: [studentPhotoId], references: [id])
  aadhaar               MediaFile?         @relation("aadhaar", fields: [aadhaarId], references: [id])
  previousMarksCard     MediaFile?         @relation("previousMarksCard", fields: [previousMarksCardId], references: [id])
  attendanceRecords     AttendanceRecord[]
  feeAllocations        FeeAllocation[]
  assignmentSubmissions AssignmentSubmission[]
  examResults           ExamResult[]
  placements            StudentPlacement[]
  internships           InternshipRecord[]
  semesterGrades        StudentSemesterGrade[]
  bookIssues            BookIssueRecord[]

  @@unique([academyId, admissionNumber], name: "uq_students_academy_admission_number")
  @@index([academyId])
  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
  @@index([departmentId])
  @@index([userId])
  @@index([semester])
  @@index([rollNumber])
  @@index([universityRegNumber])
  @@index([studentStatus])
  @@map("students")
}

model TimetableSchedule {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId    String      @map("academy_id") @db.Uuid
  branchId     String      @map("branch_id") @db.Uuid
  departmentId String?     @map("department_id") @db.Uuid
  courseId     String      @map("course_id") @db.Uuid
  batchId      String      @map("batch_id") @db.Uuid
  subjectId    String      @map("subject_id") @db.Uuid
  teacherId    String      @map("teacher_id") @db.Uuid
  dayOfWeek    String      @map("day_of_week") @db.VarChar(50)
  startTime    String      @map("start_time") @db.VarChar(50)
  endTime      String      @map("end_time") @db.VarChar(50)
  roomNumber   String?     @map("room_number") @db.VarChar(100)
  isLab        Boolean     @default(false) @map("is_lab")
  status       String      @default("active") @db.VarChar(50)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz

  academy      Academy     @relation(fields: [academyId], references: [id], onDelete: Cascade)
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  course       Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch        Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject      Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([academyId])
  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
  @@index([departmentId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([dayOfWeek])
  @@map("timetable_schedules")
}

model PlacementDrive {
  id                  String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academyId           String             @map("academy_id") @db.Uuid
  companyName         String             @map("company_name") @db.VarChar(255)
  jobRole             String             @map("job_role") @db.VarChar(255)
