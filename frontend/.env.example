# ==========================================
# HYVORA Degree College EduERP - Frontend Environment Template
# ==========================================

# Production API Endpoint (Degree College NestJS API Gateway)
NEXT_PUBLIC_API_URL=https://api.degree.hyvora.in/api/v1

# Frontend Application Domain (Used for multi-tenant and portal subdomains)
NEXT_PUBLIC_APP_DOMAIN=degree.hyvora.in

# Supabase Client Configuration (Public/Anon Key Only - Dedicated Degree College Project)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
